# -------------------------------------------------
# 1️⃣ BASE URL – Donde corre tu front‑end
# -------------------------------------------------
APP_URL=http://localhost:3000
#  • Valor usado en desarrollo.  
#  • En producción debe apuntar al dominio público (ej. https://mi-tienda.com).  
#  • Todas las URLs de verificación de email se construyen con esta variable.

NEXT_PUBLIC_APP_URL=http://localhost:3000
#  • Versión pública (expuesta al cliente) del mismo endpoint.  
#  • Se usa en componentes/client‑side que necesiten saber la URL base.

# -------------------------------------------------
# 2️⃣ RESEND – Servicio de envío de emails
# -------------------------------------------------
RESEND_API_KEY=re_BhcSU6Ek_PQ2dJoQQbRofezoHzwd4e9gR
#  • Clave de la cuenta de Resend.  
#  • En pruebas usamos la clave de desarrollo; **cámbiala** por la clave de tu dominio verificado antes del deploy.

MAIL_FROM=onboarding@resend.dev
#  • Remitente usado mientras tu dominio no está verificado en Resend.  
#  • Una vez que tengas el dominio propio, actualiza a algo como `no-reply@mi-tienda.com`.  
#  • Si el dominio no está verificado, Resend devolverá 403 (ver logs en `mailer.ts`).

# -------------------------------------------------
# 3️⃣ BASE DE DATOS – PostgreSQL
# -------------------------------------------------
DATABASE_URL="postgresql://admin:admin123@localhost:5432/mi_db?schema=public"
#  • Cadena de conexión para Prisma.  
#  • En producción deberás apuntar a tu instancia de RDS / Cloud‑SQL, con credenciales seguras (no guardes contraseñas en texto plano en CI).

# -------------------------------------------------
# 4️⃣ AUTH – NextAuth
# -------------------------------------------------
AUTH_SECRET="E2ThLZNlnh3kcQEYYALUbSV03NPlo1IbEKyQEosGVCU="
#  • Se usa para firmar cookies y tokens.  
#  • Genera uno nuevo en producción (`openssl rand -base64 32`) y **no lo compartas**.

GOOGLE_CLIENT_ID=587938529183-qto8p8m91rh024dquvitn2cbae8nv8ou.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
#  • Credenciales OAuth de Google.  
#  • En prod crea un *OAuth client* propio con el dominio de producción y sustituye los valores.  
#  • Asegúrate de que `Authorized redirect URIs` incluyan  
#      `https://mi-tienda.com/api/auth/callback/google`.

# -------------------------------------------------
# 5️⃣ MERCADOPAGO – Gateway de pagos
# -------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=APP_USR-1683630795176104-031909-9a28fd0917075416c75c4965411aa6d9-3278141442
MERCADOPAGO_PUBLIC_KEY=APP_USR-c8d586e0-ea7c-4695-8ac5-3d5b2d3a1b0f
MERCADOPAGO_WEBHOOK_SECRET=f292640384e5ab1e19204d60ed0d84df4dba17fcc1f2289571ed2285788f3d45
#  • Credenciales de la cuenta de Mercado Pago.  
#  • En staging usan la misma clave de prueba; en prod reemplaza por las credenciales reales.  
#  • Mantén el *webhook secret* en un secret manager (AWS Secrets Manager, Vercel env, etc.) – no lo versionas.

# -------------------------------------------------
# 6️⃣ EMAIL BRANDING – Logo y nombre que aparecen en los correos
# -------------------------------------------------
EMAIL_BRAND_NAME=Mi Tienda
#  • Nombre que se inserta en el encabezado del correo.  
#  • Cambia este valor cuando cambies el nombre de la marca.

EMAIL_LOGO_URL=https://mi-tienda.com/logo.png
#  • URL pública de tu logo (opcional).  
#  • Si la URL no es accesible, el email seguirá sin logo pero seguirá funcionando.

# -------------------------------------------------
# 7️⃣ OTRAS VARIABLES OPCIONALES (comentadas)
# -------------------------------------------------
# APP_URL=https://b3dd-190-122-91-75.ngrok-free.app
# NEXT_PUBLIC_APP_URL=https://b3dd-190-122-91-75.ngrok-free.app
#  • Ejemplo de túnel ngrok usado en pruebas locales remotas.  
#  • Descomenta solo cuando necesites exponer temporalmente tu dev a internet.

# SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS
#  • Variables de configuración de un servidor SMTP tradicional.  
#  • Actualmente no se usan porque el proyecto emplea **Resend**, pero pueden servir de fallback.

# -------------------------------------------------
# 8️⃣ VARIABLES DE ENTORNO DE CONTENEDOR (Docker, CI/CD)
# -------------------------------------------------
DB_USER=admin
DB_NAME=mi_db
DB_PASSWORD=admin123
#  • Usadas por `docker-compose.yml` para levantar la base de datos.  
#  • En CI/CD deberías inyectarlas como secrets y no dejar valores hard‑coded.

# -------------------------------------------------
# 9️⃣ OTROS (espacio reservado)
# -------------------------------------------------
# (líneas vacías para futuras variables)

