// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Size {
  XS
  S
  M
  L
  XL
  XXL
  XXXL
  UNICO
  AJUSTABLE
}

enum Gender {
  men
  women
  kid
  unisex
}

enum Role {
  user
  admin
}

model Category {
  id      String    @id @default(uuid())
  name    String    @unique
  Product Product[]
}

model Product {
  id          String   @id @default(uuid())
  title       String
  description String
  inStock     Int
  price       Float    @default(0)
  sizes       Size[]   @default([])
  slug        String   @unique
  tags        String[] @default([])
  gender      Gender

  //Relaciones
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String

  ProductImage ProductImage[]

  orderItems OrderItem[] // Relación inversa: productos que aparecen en órdenes

  @@index([gender])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  url       String
  product   Product @relation(fields: [productId], references: [id])
  productId String

  @@index([productId])
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(user)

  addresses           UserAddress[]
  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[] // Relación inversa: órdenes realizadas por el usuario
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Province {
  id             String         @id
  name           String
  UserAddress    UserAddress[]
  orderAddresses OrderAddress[] // Relación inversa: direcciones de envío en órdenes
}

model UserAddress {
  id          String  @id @default(cuid())
  fullname    String
  street      String
  apartment   String?
  zip         String
  city        String
  phone       String
  dni         String
  description String?
  isDefault   Boolean @default(false)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  sessionId String?

  provinceId String
  province   Province @relation(fields: [provinceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Estado del ciclo de vida de una orden
enum OrderStatus {
  pending   // Orden creada, esperando pago
  paid      // Pago confirmado
  cancelled // Orden cancelada por el usuario o el sistema
}

// Orden de compra: snapshot financiero del pedido al momento de crearse
model Order {
  id String @id @default(uuid())

  // Relación: usuario que realizó la orden
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Totales calculados en el servidor (nunca del frontend)
  itemsInOrder Int
  subTotal     Float
  tax          Float
  shipping     Float
  total        Float

  // Estado de pago
  isPaid Boolean   @default(false)
  paidAt DateTime?

  status OrderStatus @default(pending)

  // Token de idempotencia para evitar duplicados por doble click
  idempotencyToken String? @unique

  // Relaciones: items de la orden y dirección de envío
  OrderItem    OrderItem[]
  OrderAddress OrderAddress?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Línea de producto dentro de una orden: guarda precio al momento de la compra
model OrderItem {
  id String @id @default(uuid())

  // Relación: orden a la que pertenece (cascade delete)
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Relación: producto comprado
  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity Int
  size     Size

  price Float // Precio unitario snapshot (no cambia si el producto sube de precio)

  @@index([orderId])
  @@index([productId])
}

// Dirección de envío snapshot: copia de la dirección al momento de crear la orden
// (si el usuario cambia su dirección después, la orden conserva la original)
model OrderAddress {
  id String @id @default(uuid())

  // Relación 1:1 con la orden
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  fullname    String
  street      String
  apartment   String?
  zip         String
  city        String
  phone       String
  dni         String
  description String?

  // Relación: provincia de envío
  provinceId String
  province   Province @relation(fields: [provinceId], references: [id])

  createdAt DateTime @default(now())
}
