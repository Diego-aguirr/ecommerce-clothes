# =================================================
#  🔧  SAURON E-Commerce — Variables de Entorno
# =================================================
#  Copia este archivo como `.env` y completa los valores.
#  NUNCA subas tu archivo `.env` al repositorio.
#
#  Las variables marcadas con 🔴 son OBLIGATORIAS.
#  Las variables marcadas con 🟡 son opcionales o tienen valor por defecto.
# =================================================


# -------------------------------------------------
# 1️⃣  APP – URL base de la aplicación       🔴
# -------------------------------------------------
APP_URL=https://shop.builtbyaguirre.com
#  • En producción → https://shop.builtbyaguirre.com
#  • Se usa para construir enlaces en emails de verificación y reset de contraseña.

NEXT_PUBLIC_APP_URL=https://shop.builtbyaguirre.com
#  • Misma URL pero accesible desde el cliente (componentes React).
#  • En producción → https://shop.builtbyaguirre.com
#  • Se usa en el checkout de Mercado Pago (redirect URLs).


# -------------------------------------------------
# 2️⃣  BASE DE DATOS – PostgreSQL             🔴
# -------------------------------------------------
DATABASE_URL="postgresql://usuario:contraseña@host:5432/nombre_db?schema=public"
#  • Cadena de conexión para Prisma.
#  • En desarrollo → postgresql://admin:admin123@localhost:5432/mi_db?schema=public
#  • En producción → usa la URL de tu instancia (Supabase, Railway, Neon, RDS, etc.)
#  • ⚠️  No uses credenciales de desarrollo en producción.


# -------------------------------------------------
# 3️⃣  AUTH – NextAuth v5                     🔴
# -------------------------------------------------
AUTH_SECRET=
#  • Clave secreta para firmar cookies y tokens JWT.
#  • Genera una nueva con: openssl rand -base64 32
#  • ⚠️  NUNCA reutilices la clave de desarrollo en producción.
#  • ⚠️  Si la cambias, todas las sesiones activas se invalidan.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#  • Credenciales OAuth 2.0 de Google Cloud Console.
#  • Pasos:
#     1. Ir a https://console.cloud.google.com/apis/credentials
#     2. Crear un "OAuth 2.0 Client ID" de tipo "Web application"
#     3. En "Authorized redirect URIs" agregar:
#        - Producción: https://shop.builtbyaguirre.com/api/auth/callback/google
#     4. Copiar Client ID y Client Secret acá.


# -------------------------------------------------
# 4️⃣  CLOUDINARY – Almacenamiento de imágenes 🔴
# -------------------------------------------------
#  Opción A: URL completa (el SDK se auto-configura)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

#  Opción B: Variables separadas (si no usas CLOUDINARY_URL)
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu_cloud_name
# CLOUDINARY_API_KEY=tu_api_key
# CLOUDINARY_API_SECRET=tu_api_secret
#
#  • Se necesita para subir imágenes de productos desde el Admin.
#  • Pasos:
#     1. Crear cuenta en https://cloudinary.com
#     2. Ir a Dashboard → copiar Cloud Name, API Key y API Secret
#     3. Usar la Opción A (recomendada) o la B.
#  • ⚠️  Sin esto, el botón "Agregar imagen" en productos no funciona.


# -------------------------------------------------
# 5️⃣  MERCADOPAGO – Gateway de pagos          🔴
# -------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=
#  • Access Token de tu cuenta de Mercado Pago.
#  • Obtener en: https://www.mercadopago.com.ar/developers/panel/app
#  • Usa credenciales de PRUEBA en desarrollo y de PRODUCCIÓN en el deploy.

MERCADOPAGO_PUBLIC_KEY=
#  • Public Key de Mercado Pago (usada en el frontend para inicializar el SDK).

MERCADOPAGO_WEBHOOK_SECRET=
#  • Secret para verificar la autenticidad de los webhooks de Mercado Pago.
#  • Se configura en: Panel de MP → Webhooks → tu aplicación.
#  • Webhook URL: https://shop.builtbyaguirre.com/api/payments/webhook
#  • ⚠️  Sin este secret, cualquiera podría falsificar un pago.


# -------------------------------------------------
# 6️⃣  RESEND – Servicio de emails             🔴
# -------------------------------------------------
RESEND_API_KEY=
#  • Clave API de Resend (https://resend.com/api-keys).
#  • En desarrollo podés usar la clave de prueba.
#  • En producción necesitás verificar tu dominio en Resend.

MAIL_FROM=noreply@shop.builtbyaguirre.com
#  • Dirección del remitente.
#  • En producción → noreply@shop.builtbyaguirre.com (requiere dominio verificado en Resend).
#  • ⚠️  Si usás un dominio no verificado, Resend devuelve 403.


# -------------------------------------------------
# 7️⃣  EMAIL BRANDING – Personalización        🟡
# -------------------------------------------------
EMAIL_BRAND_NAME=SAURON
#  • Nombre de la marca que aparece en los emails enviados al cliente.

EMAIL_LOGO_URL=
#  • URL pública del logo de la marca para emails (opcional).
#  • Ejemplo: https://shop.builtbyaguirre.com/logo.png
#  • Si está vacía, el email se envía sin logo.


# -------------------------------------------------
# 8️⃣  DOCKER – Variables para docker-compose  🟡
# -------------------------------------------------
POSTGRES_USER=sauron
POSTGRES_PASSWORD=sauron123
POSTGRES_DB=sauron_db
#  • Usadas por docker-compose.yml para levantar PostgreSQL local.
#  • Deben coincidir con DATABASE_URL.
#  • Solo aplican en desarrollo. En producción la DB ya está provista.


# -------------------------------------------------
# 9️⃣  TÚNEL / NGROK – Solo desarrollo         🟡
# -------------------------------------------------
# APP_URL=https://xxxx.ngrok-free.app
# NEXT_PUBLIC_APP_URL=https://xxxx.ngrok-free.app
#  • Descomenta solo cuando necesites exponer tu dev local a internet
#    (ej: para probar webhooks de Mercado Pago).
#  • ⚠️  Nunca dejes ngrok en producción.
